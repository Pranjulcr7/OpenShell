# Create the mTLS default and migrate legacy auth overrides on refresh.
set -eu

config_file="${SNAP_COMMON}/gateway.toml"
# Never replace operator-owned symlinks or non-regular files.
if [ -L "$config_file" ] || { [ -e "$config_file" ] && [ ! -f "$config_file" ]; }; then
	exit 0
fi

mkdir -p "$SNAP_COMMON"
umask 077
temporary_file=$(mktemp "${config_file}.tmp.XXXXXX")
trap 'rm -f "$temporary_file"' 0 HUP INT TERM
if [ -f "$config_file" ]; then
	# A failed migration leaves the original file intact and fails the hook.
	"${SNAP}/bin/openshell-gateway" config migrate-mtls --path "$config_file" >"$temporary_file"
	cmp -s "$config_file" "$temporary_file" && exit 0
	echo "openshell: disabling legacy gateway auth overrides; preserving custom settings" >&2
else
	cat >"$temporary_file" <<'CONFIG'
[openshell]
version = 2

[openshell.gateway]
CONFIG
fi
mv -f "$temporary_file" "$config_file"
trap - 0 HUP INT TERM
